# Local settings, loaded at startup by `python -m insights` (python-dotenv). Copy to .env (gitignored)
# and fill in. Variables already set in the environment (a session or CI secret) win over this file.
# On the Pi the same variables come from /etc/pnct-insights/insights.env (insights/deploy/README.md).

# PNCT Insights: Telegram delivery of draft posts (only sendPhoto and sendMessage are ever called).
INSIGHTS_TELEGRAM_BOT_TOKEN=123456:replace-me
INSIGHTS_TELEGRAM_CHAT_ID=replace-me

# Optional: where posted.json and the rendered drafts go (defaults: insights/state, insights/out).
#INSIGHTS_STATE_DIR=insights/state
#INSIGHTS_OUT_DIR=insights/out
