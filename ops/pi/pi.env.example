# /etc/pnct/pi.env (root:root, chmod 600), read by systemd for pnct-source-watcher.service.
# Copy this file there (install.sh does it once) and fill it in. Never commit the real file.

# A bot token from @BotFather. A separate bot keeps the watcher apart from Prazo; Prazo's token also
# works (the watcher only calls sendMessage, which doesn't conflict with Prazo's polling or webhook).
TELEGRAM_BOT_TOKEN=123456:replace-me
# Your chat with the bot: send it a message, then open
# https://api.telegram.org/bot<token>/getUpdates and copy message.chat.id.
TELEGRAM_CHAT_ID=replace-me

# Optional: where state.json lives (a few KB). Default /var/lib/pnct-watcher (systemd StateDirectory).
# Re-run install.sh after changing it.
#STATE_DIR=/var/lib/pnct-watcher
