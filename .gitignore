# Python / tooling
.venv/
__pycache__/
.pytest_cache/
.npm-cache/
node_modules/
.wrangler/

# Local env and OS files
.env
.env.*
*.local
.DS_Store

# Delegation logs (local only)
.kiro-logs/

# Source downloads and large pipeline intermediates (regenerated by `make`).
# The site only needs web/data/*.json, which stay committed.
data/external/
data/raw/*.pdf
data/interim/parishes_full_4326.geojson
data/interim/protected/
data/interim/contacts/
# Hand-annotated working files (contact candidates under review). Kept out of git (unreviewed
# scraped mailboxes) and out of every clean target (tests/test_clean.py).
data/manual/
data/processed/*.geojson
# Land check files (docs/land-check/HOSTING.md): built by `make landcheck`, served by Cloudflare Pages,
# too large for git (15.7 + 13.5 MiB). web/data/landcheck.meta.json names them and stays committed.
web/public/landcheck/

# Local screenshots and other throwaway outputs
.artifacts/
