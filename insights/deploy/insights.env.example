# /etc/pnct-insights/insights.env: read by systemd (EnvironmentFile=) for pnct-insights.service.
# chmod 600, owned by the service user (pnct-insights). Never commit the real file.

# The existing dev bot's token. The service only calls sendPhoto and sendMessage, never getUpdates
# or setWebhook, so it doesn't interfere with the app that polls this bot.
INSIGHTS_TELEGRAM_BOT_TOKEN=123456:replace-me
# Your chat ID with the bot.
INSIGHTS_TELEGRAM_CHAT_ID=replace-me
